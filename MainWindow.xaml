<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceScan" Width="1280" Height="820" MinWidth="960" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="#0a0d13" Foreground="#e8eef6" FontSize="13.5" UseLayoutRounding="True"
        FontFamily="IBM Plex Sans, Segoe UI Variable Text, Segoe UI">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <!-- Tokens from the Branding note: ground, white-alpha panels/edges, three text steps, one accent. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#e8eef6"/>
    <SolidColorBrush x:Key="Dim" Color="#8a97aa"/>
    <SolidColorBrush x:Key="Dimmer" Color="#5d6879"/>
    <SolidColorBrush x:Key="Accent" Color="#4c8dff"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2B4C8DFF"/>
    <SolidColorBrush x:Key="Panel" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="Panel2" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Edge" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="EdgeBright" Color="#2EFFFFFF"/>
    <FontFamily x:Key="Mono">IBM Plex Mono, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Display">Bricolage Grotesque, Segoe UI Variable Display, Segoe UI</FontFamily>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Dimmer}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Hdr" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Dimmer}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HdrRight" TargetType="Button" BasedOn="{StaticResource Hdr}">
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="Num" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Pill buttons: ghost = edge-bright border on panel; primary = accent fill, near-black text, colored shadow. Hover changes only the fill. -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource EdgeBright}"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="17" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1AFFFFFF"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#06101f"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect Color="#4c8dff" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.34"/></Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6a9fff"/></Trigger>
      </Style.Triggers>
    </Style>

    <!-- Segmented control: active tab = accent at .17 plus a 1px inner ring. -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Height="30" CornerRadius="15" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="16,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#804c8dff"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Form field: dark inset, edge-bright border, accent border on focus. -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="#40000000"/>
      <Setter Property="BorderBrush" Value="{StaticResource EdgeBright}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SmallField" TargetType="TextBox" BasedOn="{StaticResource Field}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <!-- Scrollbar: 10px grab zone, 6px visible thumb, translucent white 0.16 / 0.30 / 0.42. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="t" Background="#29FFFFFF" CornerRadius="3" Margin="2"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#4DFFFFFF"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="#6BFFFFFF"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rows: hover = panel-2; selected = accent .17 plus a 3px accent bar on the leading edge (a full border on a wide row reads as a focused input). -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
      <Setter Property="Height" Value="28"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="bg" Background="Transparent"/>
              <Border x:Name="lead" Width="3" HorizontalAlignment="Left" Margin="0,4" CornerRadius="2" Background="{StaticResource Accent}" Visibility="Collapsed"/>
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Stretch"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{StaticResource Panel2}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="lead" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DriveItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
      <Setter Property="Height" Value="48"/>
    </Style>
    <Style x:Key="Rows" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>

    <!-- Own caption buttons: the system ones are drawn under the client area, i.e. under the tint. -->
    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1AFFFFFF"/>
          <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#c42b1c"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Context menu stays opaque (menus on glass become unreadable). -->
    <Style x:Key="MI" TargetType="MenuItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="12,7">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="32,0,0,0" Foreground="{StaticResource Dimmer}"
                           FontFamily="{StaticResource Mono}" FontSize="11.5" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Sep" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator"><Border Height="1" Margin="8,4" Background="#262b36"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ContextMenu x:Key="RowMenu" Foreground="#e8eef6" FontSize="13" HasDropShadow="False">
      <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="#10141d" BorderBrush="#262b36" BorderThickness="1" CornerRadius="12" Padding="5">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </ContextMenu.Template>
      <MenuItem Style="{StaticResource MI}" Tag="open" Header="Open" InputGestureText="Enter"/>
      <MenuItem Style="{StaticResource MI}" Tag="explorer" Header="Show in Explorer"/>
      <MenuItem Style="{StaticResource MI}" Tag="filelabs" Header="Open in File Labs"/>
      <MenuItem Style="{StaticResource MI}" Tag="copypath" Header="Copy path" InputGestureText="Ctrl+C"/>
      <Separator Style="{StaticResource Sep}"/>
      <MenuItem Style="{StaticResource MI}" Tag="copy" Header="Copy to…"/>
      <MenuItem Style="{StaticResource MI}" Tag="move" Header="Move to…"/>
      <Separator Style="{StaticResource Sep}"/>
      <MenuItem Style="{StaticResource MI}" Tag="recycle" Header="Delete to Recycle Bin" InputGestureText="Del"/>
      <MenuItem Style="{StaticResource MI}" Tag="delete" Header="Delete permanently" InputGestureText="Shift+Del" Foreground="#ff5c8a"/>
      <Separator Style="{StaticResource Sep}"/>
      <MenuItem Style="{StaticResource MI}" Tag="rescan" Header="Rescan" InputGestureText="F5"/>
      <MenuItem Style="{StaticResource MI}" Tag="props" Header="Properties"/>
    </ContextMenu>

    <DataTemplate x:Key="TreeRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="76"/><ColumnDefinition Width="104"/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="{Binding Indent}">
          <Border x:Name="chev" DockPanel.Dock="Left" Width="18" Background="Transparent" Cursor="Hand">
            <TextBlock Text="{Binding Chevron}" Foreground="{StaticResource Dim}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Border>
          <Path DockPanel.Dock="Left" Data="{Binding IconData}" Fill="{Binding IconBrush}" Width="14" Height="12" Stretch="Uniform" Margin="3,0,9,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding DisplayName}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Column="1" Width="150" Height="6" HorizontalAlignment="Left" Margin="12,0,0,0">
          <Border Background="{StaticResource Edge}" CornerRadius="3"/>
          <Border Background="{Binding BarBrush}" CornerRadius="3" Width="{Binding BarWidth}" HorizontalAlignment="Left"/>
        </Grid>
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding SizeText}"/>
        <TextBlock Grid.Column="3" Style="{StaticResource Num}" Text="{Binding PctText}" Foreground="{StaticResource Dim}"/>
        <TextBlock Grid.Column="4" Style="{StaticResource Num}" Text="{Binding FilesText}" Foreground="{StaticResource Dim}" Margin="0,0,16,0"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ExtRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="76"/><ColumnDefinition Width="104"/><ColumnDefinition Width="130"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Ext}" FontFamily="{StaticResource Mono}" FontSize="12.5" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Style="{StaticResource Num}" Text="{Binding SizeText}"/>
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding PctText}" Foreground="{StaticResource Dim}"/>
        <TextBlock Grid.Column="3" Style="{StaticResource Num}" Text="{Binding CountText}" Foreground="{StaticResource Dim}"/>
        <TextBlock Grid.Column="4" Style="{StaticResource Num}" Text="{Binding AvgText}" Foreground="{StaticResource Dim}" Margin="0,0,16,0"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="FoundRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Style="{StaticResource Num}" Text="{Binding SizeText}"/>
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding ModifiedText}" Foreground="{StaticResource Dim}"/>
        <TextBlock Grid.Column="3" Text="{Binding Folder}" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="24,0,16,0"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DupRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" Margin="{Binding Indent}" FontWeight="{Binding Weight}" Foreground="{Binding NameBrush}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Style="{StaticResource Num}" Text="{Binding SizeText}"/>
        <TextBlock Grid.Column="2" Text="{Binding Info}" Foreground="{Binding InfoBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="24,0,16,0"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DriveRow">
      <Grid Height="40">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Dimmer}" FontSize="11.5"/>
        </StackPanel>
        <Grid Grid.Column="1" Width="180" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Border Background="{StaticResource Edge}" CornerRadius="4"/>
          <Border Background="{Binding BarBrush}" CornerRadius="4" Width="{Binding BarWidth}" HorizontalAlignment="Left"/>
        </Grid>
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding UsedText}"/>
        <TextBlock Grid.Column="3" Style="{StaticResource Num}" Text="{Binding TotalText}" Foreground="{StaticResource Dim}"/>
        <TextBlock Grid.Column="4" Style="{StaticResource Num}" Text="{Binding FreeText}" Foreground="{StaticResource Dim}" Margin="0,0,16,0"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="CmpRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Style="{StaticResource Num}" Text="{Binding BeforeText}" Foreground="{StaticResource Dim}"/>
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding AfterText}" Foreground="{StaticResource Dim}"/>
        <TextBlock Grid.Column="3" Style="{StaticResource Num}" Text="{Binding DeltaText}" Foreground="{Binding DeltaBrush}" FontWeight="SemiBold" Margin="0,0,16,0"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TopRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="76"/><ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Style="{StaticResource Num}" Text="{Binding SizeText}"/>
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding PctText}" Foreground="{StaticResource Dim}"/>
        <TextBlock Grid.Column="3" Text="{Binding Folder}" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="24,0,16,0"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <!-- Aura: discreet accent top-left, violet top-right. If it reads as a shape, it's too strong. -->
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.22,0" GradientOrigin="0.22,0" RadiusX="0.58" RadiusY="0.5">
          <GradientStop Color="#334c8dff" Offset="0"/><GradientStop Color="#004c8dff" Offset="0.7"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.78,0.06" GradientOrigin="0.78,0.06" RadiusX="0.46" RadiusY="0.44">
          <GradientStop Color="#24b15cff" Offset="0"/><GradientStop Color="#00b15cff" Offset="0.7"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <!-- Tint over the acrylic: transparency has a floor, text must stay readable. -->
    <Border x:Name="tint" Background="#E00a0d13" IsHitTestVisible="False"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1">
      <Button x:Name="minBtn" Style="{StaticResource Caption}" Content="&#xE921;"/>
      <Button x:Name="maxBtn" Style="{StaticResource Caption}" Content="&#xE922;"/>
      <Button x:Name="closeBtn" Style="{StaticResource CaptionClose}" Content="&#xE8BB;"/>
    </StackPanel>

    <Popup x:Name="excludePopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" VerticalOffset="8" HorizontalOffset="-180">
      <Border Background="#10141d" BorderBrush="#262b36" BorderThickness="1" CornerRadius="12" Padding="16" Width="460">
        <StackPanel>
          <TextBlock Style="{StaticResource Eyebrow}" Text="SKIP THESE WHILE SCANNING — ONE RULE PER LINE"/>
          <TextBox x:Name="excludeBox" Style="{StaticResource Field}" Height="150" Margin="0,10,0,0" AcceptsReturn="True"
                   VerticalContentAlignment="Top" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Foreground="{StaticResource Dimmer}" FontSize="11.5" TextWrapping="Wrap" Margin="2,10,0,0"
                     Text="node_modules — any folder or file with that name.   *.iso — every file with that extension.   C:\Windows\Temp — that path and everything under it. Rules apply to the next scan."/>
          <Button x:Name="excludeApply" Style="{StaticResource Primary}" Content="Save" HorizontalAlignment="Right" Margin="0,14,0,0"/>
          <Border Height="1" Background="{StaticResource Edge}" Margin="0,16,0,0"/>
          <TextBlock Style="{StaticResource Eyebrow}" Text="INTEGRATION" Margin="0,16,0,0"/>
          <DockPanel Margin="0,10,0,0">
            <Button x:Name="shellBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Add" Margin="10,0,0,0"/>
            <TextBlock Text="Right-click menu in Explorer" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </DockPanel>
          <DockPanel Margin="0,10,0,0">
            <Button x:Name="fileLabsBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Get it" Margin="10,0,0,0"/>
            <TextBlock x:Name="fileLabsText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Dim}"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Popup>

    <Grid x:Name="shell" Margin="18,0,18,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Height="56" Margin="0,0,138,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,18,0">
          <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}" VerticalAlignment="Center">
            <Ellipse.Effect><DropShadowEffect Color="#4c8dff" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
          </Ellipse>
          <TextBlock Text="SpaceScan" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,2" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="scanBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Scan" Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="browseBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Browse…" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="excludeBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Settings" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="drivesBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Drives  ▾" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <TextBox x:Name="pathBox" Style="{StaticResource Field}" Height="34" MaxWidth="560" HorizontalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True"/>
      </DockPanel>

      <DockPanel Grid.Row="1" Margin="0,6,0,12">
        <Button x:Name="exportBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Export  ▾"/>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="19" Padding="3" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="tabDrives" Style="{StaticResource Seg}" GroupName="view" Content="Drives"/>
            <RadioButton x:Name="tabTree" Style="{StaticResource Seg}" GroupName="view" Content="Folders" IsChecked="True"/>
            <RadioButton x:Name="tabExt" Style="{StaticResource Seg}" GroupName="view" Content="File types"/>
            <RadioButton x:Name="tabTop" Style="{StaticResource Seg}" GroupName="view" Content="Largest files"/>
            <RadioButton x:Name="tabSearch" Style="{StaticResource Seg}" GroupName="view" Content="Search"/>
            <RadioButton x:Name="tabDup" Style="{StaticResource Seg}" GroupName="view" Content="Duplicates"/>
            <RadioButton x:Name="tabCmp" Style="{StaticResource Seg}" GroupName="view" Content="Compare"/>
          </StackPanel>
        </Border>
      </DockPanel>

      <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="14">
        <Grid>
          <Grid x:Name="viewDrives" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="14,12,12,10" LastChildFill="False">
              <Button x:Name="scanAllBtn" Style="{StaticResource Primary}" Content="Scan all local drives" Margin="0"/>
              <TextBlock Foreground="{StaticResource Dimmer}" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12.5"
                         Text="Double-click a drive to scan just that one."/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Eyebrow}" Text="DRIVE"/>
              <TextBlock Grid.Column="1" Style="{StaticResource Eyebrow}" Text="USED"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="USED" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Style="{StaticResource Eyebrow}" Text="TOTAL" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="4" Style="{StaticResource Eyebrow}" Text="FREE" HorizontalAlignment="Right" Margin="0,0,16,0"/>
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Edge}"/>
            <ListBox x:Name="driveList" Grid.Row="2" Style="{StaticResource Rows}" ItemTemplate="{StaticResource DriveRow}" ItemContainerStyle="{StaticResource DriveItem}"/>
          </Grid>
          <Grid x:Name="viewTree">
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
            <Grid Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="76"/><ColumnDefinition Width="104"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Eyebrow}" Text="NAME" Margin="18,0,0,0"/>
              <TextBlock Grid.Column="1" Style="{StaticResource Eyebrow}" Text="OF PARENT" Margin="12,0,0,0"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="SIZE" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Style="{StaticResource Eyebrow}" Text="%" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="4" Style="{StaticResource Eyebrow}" Text="FILES" HorizontalAlignment="Right" Margin="0,0,16,0"/>
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Edge}"/>
            <ListBox x:Name="treeList" Grid.Row="1" Style="{StaticResource Rows}" ItemTemplate="{StaticResource TreeRow}" SelectionMode="Extended"/>
            <StackPanel x:Name="emptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
              <TextBlock Text="Nothing scanned yet" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="Pick a drive or folder above and press Scan. Whole NTFS drives are read straight from the MFT." Foreground="{StaticResource Dim}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <Grid x:Name="viewExt" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="19" Padding="3"
                    HorizontalAlignment="Left" Margin="14,12,0,10">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="byExt" Style="{StaticResource Seg}" GroupName="grouping" Content="Extensions" IsChecked="True"/>
                <RadioButton x:Name="byCat" Style="{StaticResource Seg}" GroupName="grouping" Content="Categories"/>
              </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="76"/><ColumnDefinition Width="104"/><ColumnDefinition Width="130"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="extHdrName" Style="{StaticResource Hdr}" Content="EXTENSION"/>
              <Button x:Name="extHdrSize" Grid.Column="1" Style="{StaticResource HdrRight}" Content="SIZE"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="%" HorizontalAlignment="Right"/>
              <Button x:Name="extHdrFiles" Grid.Column="3" Style="{StaticResource HdrRight}" Content="FILES"/>
              <Button x:Name="extHdrAvg" Grid.Column="4" Style="{StaticResource HdrRight}" Content="AVERAGE SIZE" Margin="0,0,16,0"/>
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Edge}"/>
            <ListBox x:Name="extList" Grid.Row="2" Style="{StaticResource Rows}" ItemTemplate="{StaticResource ExtRow}"/>
          </Grid>
          <Grid x:Name="viewTop" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
            <Grid Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="76"/><ColumnDefinition Width="3*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="topHdrName" Style="{StaticResource Hdr}" Content="NAME"/>
              <Button x:Name="topHdrSize" Grid.Column="1" Style="{StaticResource HdrRight}" Content="SIZE"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="%" HorizontalAlignment="Right"/>
              <Button x:Name="topHdrFolder" Grid.Column="3" Style="{StaticResource Hdr}" Content="FOLDER" Margin="24,0,0,0"/>
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Edge}"/>
            <ListBox x:Name="topList" Grid.Row="1" Style="{StaticResource Rows}" ItemTemplate="{StaticResource TopRow}" SelectionMode="Extended"/>
          </Grid>
          <Grid x:Name="viewSearch" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="14,12,12,10" LastChildFill="False">
              <TextBlock Style="{StaticResource Eyebrow}" Text="NAME CONTAINS" Margin="0,0,8,0"/>
              <TextBox x:Name="findName" Style="{StaticResource SmallField}" Width="220"/>
              <TextBlock Style="{StaticResource Eyebrow}" Text="MIN SIZE" Margin="18,0,8,0"/>
              <TextBox x:Name="findSize" Style="{StaticResource SmallField}" Width="90" Text="100 MB"/>
              <TextBlock Style="{StaticResource Eyebrow}" Text="UNTOUCHED FOR (DAYS)" Margin="18,0,8,0"/>
              <TextBox x:Name="findAge" Style="{StaticResource SmallField}" Width="70"/>
              <Button x:Name="findBtn" Style="{StaticResource Primary}" Content="Find" Margin="18,0,0,0"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="3*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="findHdrName" Style="{StaticResource Hdr}" Content="NAME"/>
              <Button x:Name="findHdrSize" Grid.Column="1" Style="{StaticResource HdrRight}" Content="SIZE"/>
              <Button x:Name="findHdrDate" Grid.Column="2" Style="{StaticResource HdrRight}" Content="MODIFIED"/>
              <Button x:Name="findHdrFolder" Grid.Column="3" Style="{StaticResource Hdr}" Content="FOLDER" Margin="24,0,0,0"/>
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Edge}"/>
            <ListBox x:Name="foundList" Grid.Row="2" Style="{StaticResource Rows}" ItemTemplate="{StaticResource FoundRow}" SelectionMode="Extended"/>
            <TextBlock x:Name="findHint" Grid.Row="2" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Search the scanned drive by name, size or age. On an NTFS drive this reads the MFT, so it takes seconds."/>
          </Grid>
          <Grid x:Name="viewDup" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="14,12,12,10" LastChildFill="False">
              <TextBlock Style="{StaticResource Eyebrow}" Text="MIN SIZE" Margin="0,0,8,0"/>
              <TextBox x:Name="dupSize" Style="{StaticResource SmallField}" Width="90" Text="10 MB"/>
              <Button x:Name="dupBtn" Style="{StaticResource Primary}" Content="Find duplicates" Margin="18,0,0,0"/>
              <TextBlock x:Name="dupSummary" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="18,0,0,0"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="3*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Eyebrow}" Text="FILE"/>
              <TextBlock Grid.Column="1" Style="{StaticResource Eyebrow}" Text="SIZE" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="FOLDER" Margin="24,0,0,0"/>
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Edge}"/>
            <ListBox x:Name="dupList" Grid.Row="2" Style="{StaticResource Rows}" ItemTemplate="{StaticResource DupRow}" SelectionMode="Extended"/>
            <TextBlock x:Name="dupHint" Grid.Row="2" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Finds files with identical contents (same size, then same hash) so you can delete the copies."/>
          </Grid>
          <Grid x:Name="viewCmp" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="14,12,12,10" LastChildFill="False">
              <Button x:Name="saveSnapBtn" Style="{StaticResource Ghost}" Content="Save snapshot…" Margin="0"/>
              <Button x:Name="cmpPrevBtn" Style="{StaticResource Primary}" Content="Compare with previous scan" Margin="10,0,0,0"/>
              <Button x:Name="cmpHistoryBtn" Style="{StaticResource Ghost}" Content="History  ▾" Margin="10,0,0,0"/>
              <Button x:Name="cmpBtn" Style="{StaticResource Ghost}" Content="Open snapshot…" Margin="10,0,0,0"/>
              <TextBlock x:Name="cmpSummary" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="18,0,0,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="cmpHdrPath" Style="{StaticResource Hdr}" Content="FOLDER"/>
              <Button x:Name="cmpHdrBefore" Grid.Column="1" Style="{StaticResource HdrRight}" Content="BEFORE"/>
              <Button x:Name="cmpHdrAfter" Grid.Column="2" Style="{StaticResource HdrRight}" Content="NOW"/>
              <Button x:Name="cmpHdrDelta" Grid.Column="3" Style="{StaticResource HdrRight}" Content="CHANGE" Margin="0,0,16,0"/>
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Edge}"/>
            <ListBox x:Name="cmpList" Grid.Row="2" Style="{StaticResource Rows}" ItemTemplate="{StaticResource CmpRow}"/>
            <TextBlock x:Name="cmpHint" Grid.Row="2" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="Save a snapshot of this scan, then compare a later scan against it to see what grew.&#10;A snapshot keeps folder sizes only, so it stays small."/>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="3" Margin="2,10,2,0">
        <Border Height="2" CornerRadius="1" Background="{StaticResource Edge}" VerticalAlignment="Top"/>
        <Border x:Name="progress" Height="2" CornerRadius="1" Background="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="0">
          <Border.Effect><DropShadowEffect Color="#4c8dff" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
        </Border>
        <DockPanel Margin="2,8,2,0" LastChildFill="True">
          <Button x:Name="elevateBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Restart as administrator"
                  Visibility="Collapsed" Height="26" Padding="14,0" FontSize="12"/>
          <TextBlock x:Name="status" VerticalAlignment="Center" Foreground="{StaticResource Dim}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
